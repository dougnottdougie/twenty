# Copy to .env and fill in. .env is gitignored (root .gitignore: **/**/.env).

# --- Cloudflare Zero Trust --------------------------------------------------
# Zero Trust dashboard > Networks > Tunnels > your tunnel > Install connector.
# Copy the token out of the shown command (the long string after --token).
CLOUDFLARE_TUNNEL_TOKEN=

# The tunnel's public hostname. Must match exactly, including https:// and no
# trailing slash — the frontend builds its API origin from this value.
SERVER_URL=https://crm.example.com

# --- Secrets ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Only set during a key rotation: the previous ENCRYPTION_KEY.
FALLBACK_ENCRYPTION_KEY=

# Generate with: openssl rand -hex 24
PG_DATABASE_PASSWORD=
#PG_DATABASE_USER=postgres

# --- Image ------------------------------------------------------------------
# IMAGE/TAG are just the local docker image name — any string works.
IMAGE=twenty-crm
TAG=local

# APP_VERSION must be valid semver. Not cosmetic: the app/plugin system refuses
# to register apps when it isn't, and app engine requirements are compared
# against it.
#
# Do NOT use `git describe` alone to pick this — upstream cuts release branches,
# so release tags are usually NOT ancestors of main and describe reports a much
# older version than you are actually running. Instead check what a release tag
# has that you don't:
#   git log --oneline HEAD..twenty/v2.31.0
# If that is empty or only trivial fixes, you are running that release. Prefer
# understating over overstating — claiming a version you aren't running lets
# incompatible apps install.
APP_VERSION=2.31.0

# --- Storage ----------------------------------------------------------------
# "local" keeps attachments in the server-local-data volume. Switch to "s3"
# (or R2, which is S3-compatible) if you want them off the host.
STORAGE_TYPE=local
#STORAGE_S3_REGION=auto
#STORAGE_S3_NAME=my-bucket
#STORAGE_S3_ENDPOINT=

# --- Startup ----------------------------------------------------------------
#DISABLE_DB_MIGRATIONS=false
#DISABLE_CRON_JOBS_REGISTRATION=false

# --- Campaigns (fork) -------------------------------------------------------
# Serves email group / campaigns from this fork's own code instead of requiring
# a Twenty Enterprise plan. Leave false until you intend to enable campaigns.
#IS_SELF_HOSTED_EMAIL_GROUP_UNGATED=false

# --- Event logs / ClickHouse (optional) -------------------------------------
# Leave BOTH commented out to keep ClickHouse off. Empty CLICKHOUSE_URL means
# event ingestion falls back to a console sink and nothing errors.
# To enable: uncomment, then `docker compose --profile clickhouse up -d`, then
# run the ClickHouse migrations to create the tables.
#CLICKHOUSE_URL=http://clickhouse:8123
#CLICKHOUSE_PASSWORD=replace_me
